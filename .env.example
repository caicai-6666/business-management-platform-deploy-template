BACKEND_DIR=./business-management-platform-be-template
MYSQL_IMAGE=mysql:8.4
MYSQL_DATABASE=platform
MYSQL_USER=platform
# 启动持久化 MySQL 前填写两个不同的随机密码
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# 派生平台实现服务后填入含启动命令的镜像
BACKEND_IMAGE=
DB_ENGINE=sqlite
BACKEND_BIND_PORT=8080
# 两个文件名均相对容器 DATA_DIR，使用不同的单层文件名
SQLITE_FILENAME=platform.sqlite3
VECTOR_ENABLED=false
VECTOR_INDEX_FILENAME=vectors.sqlite3
