BACKEND_DIR=./business-management-platform-be-template
MYSQL_DATABASE=platform
MYSQL_USER=platform
# 启动持久化 MySQL 前填写两个不同的随机密码
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# 派生平台实现服务后填入含启动命令的镜像
BACKEND_IMAGE=
BACKEND_BIND_PORT=8080
# 两个文件名均相对容器 DATA_DIR，使用不同的单层文件名
SQLITE_FILENAME=platform.sqlite3
VECTOR_INDEX_FILENAME=vectors.sqlite3

# 可选中间件。三项留空时独立运行；启用时填写服务根地址、白名单代号和私有密钥
MIDDLEWARE_BASE_URL=
MIDDLEWARE_PLATFORM_CODE=
MIDDLEWARE_SECRET=
MIDDLEWARE_REQUEST_TIMEOUT_SECONDS=30
MIDDLEWARE_RETRY_INTERVAL_SECONDS=30

# 可选钉钉内部应用；启用时同时配置前三项和专属 HTTP(S) 正向代理
DINGTALK_CORP_ID=
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_PROXY_URL=
DINGTALK_TIMEOUT_SECONDS=30
